{
  "name": "zhihuhelp",
  "version": "2.6.0",
  "type": "module",
  "description": "知乎助手 & TypeScript",
  "repository": {
    "type": "git",
    "url": "https://github.com/YaoZeyuan/zhihuhelp"
  },
  "main": "dist/index.js",
  "bin": {
    "zhihuhelp": "dist/interface/cli/main.js"
  },
  "author": "姚泽源",
  "license": "MIT OR GPL-2.0-or-later",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "startgui": "node client/script/start.js",
    "buildgui": "node client/script/build.js",
    "docs:dev": "vitepress dev doc",
    "docs:build": "vitepress build doc && node scripts/docs/copy-static-api.cjs",
    "docs:preview": "vitepress preview doc",
    "docs:check": "node scripts/docs/verify-site.cjs",
    "start": "electron dist/index.js --zhihuhelp-debug",
    "zhihuhelp": "node dist/interface/cli/main.js",
    "watch": "babel src --copy-files --watch --out-dir dist  --verbose --source-maps --extensions \".ts,.tsx,.js,.jsx\"",
    "clean:esm-stale": "node scripts/build/clean-esm-stale.cjs",
    "build": "pnpm clean:esm-stale && babel src --copy-files -d dist --verbose  --source-maps --extensions \".ts,.tsx,.js,.jsx\" ",
    "build-without-sourcemap": "pnpm clean:esm-stale && babel src --copy-files -d dist --verbose --extensions \".ts,.tsx,.js,.jsx\" ",
    "stage:licenses": "node scripts/release/create-corresponding-source.cjs --stage-license-files dist/licenses",
    "pack": "npm run build-without-sourcemap && npm run stage:licenses && npm run buildgui && electron-builder --dir",
    "dist": "npm run build-without-sourcemap && npm run stage:licenses && npm run buildgui && electron-builder",
    "electron-builder": "electron-builder",
    "postinstall-4-mac": "electron-rebuild -f -w sharp",
    "postinstall-4-win": "electron-builder install-app-deps",
    "server": "nodemon --inspect dist/start-dev-server.js",
    "tsc": "tsc --noEmit",
    "lint": "pnpm tsc && eslint src",
    "eslint": "eslint src",
    "prettier-with-fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,less,css}\"",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:client": "vitest run --project client",
    "test:integration": "vitest run --project integration",
    "test:online": "node scripts/tests/run-electron-test.cjs online",
    "fixtures:refresh": "node scripts/tests/run-electron-test.cjs fixtures"
  },
  "build": {
    "productName": "知乎助手",
    "appId": "zhihuhelp",
    "copyright": "@姚泽源",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "gui/dist/**/*",
      "node_modules/**/*",
      "LICENSE",
      "LICENSE-MIT",
      "LICENSE-GPL-2.0-or-later",
      "THIRD_PARTY_NOTICES.md",
      "CORRESPONDING_SOURCE.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "icon": "src/public/icon/icon.png"
    },
    "mac": {
      "category": "zhihuhelp.app.category.type",
      "target": "7z",
      "icon": "src/public/icon/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@optique/core": "^1.2.0",
    "@optique/run": "^1.2.0",
    "@types/tiny-async-pool": "^2.0.3",
    "adm-zip": "^0.6.0",
    "axios": "^1.19.0",
    "core-js": "^3.50.0",
    "dayjs": "^1.11.21",
    "json5": "^2.2.3",
    "knex": "^3.3.0",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.2",
    "md5": "^2.3.0",
    "module-alias": "^2.3.4",
    "moment": "^2.30.1",
    "pandoc-wasm": "^1.1.0",
    "query-string": "^9.5.0",
    "rc-field-form": "^2.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1",
    "tiny-async-pool": "^2.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-syntax-flow": "^8.0.1",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@electron/osx-sign": "",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-root-import": "^6.6.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.8.0",
    "globals": "17.9.0",
    "jsdom": "^30.0.1",
    "mermaid": "^11.16.1",
    "node-gyp": "^13.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "^4.1.10"
  }
}
